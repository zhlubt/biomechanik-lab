# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local wird NICHT committet (siehe .gitignore).

# Ab Phase 2 (echtes KI-Feedback): Anthropic API-Key — nur serverseitig genutzt.
# Hinweis: liegt in diesem Projekt bereits in der (gitignorierten) .env vor.
ANTHROPIC_API_KEY=

# Optionaler Modell-Override (Default im Code: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Optionaler Provider-Wechsel (Default: anthropic)
# LLM_PROVIDER=anthropic
