# Vorlage für private/.env. Datei kopieren, Werte eintragen, Rechte auf 640
# setzen. Sie liegt außerhalb des Webroots und darf NIE ins Repository.
#
#   cp private/.env.example private/.env && chmod 640 private/.env

# ---------------------------------------------------------------------------
# LLM: welcher Anbieter das sokratische Feedback erzeugt
# ---------------------------------------------------------------------------
# nhr = LLM-Gateway des NHR@FAU (OpenAI-kompatibel), anthropic, openai
LLM_PROVIDER=nhr

# NHR@FAU (Default in der Live-Installation)
# Key beantragen: https://hpc.fau.de/request-llm-api-key/
NHR_API_KEY=
NHR_BASE_URL=https://hub.nhr.fau.de/api/llmgw/v1
NHR_MODEL=gpt-oss-120b
# Reasoning-Modelle zählen ihre Denkspur gegen max_tokens. Zu wenig Tokens
# liefern content=null mit finish_reason=length, deshalb diese Untergrenze.
NHR_MAX_TOKENS_FLOOR=4000

# Anthropic (alternativer Adapter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (alternativer Adapter)
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Zugänge der Anwendung
# ---------------------------------------------------------------------------
# Passwort für die Pflegeoberfläche (/pflege.php)
PFLEGE_PASSWORD=

# Einladungscode für Lehrende. Wer konto.php?lehrcode=<CODE> öffnet, bekommt
# ein Konto mit der Rolle teacher und sieht damit die Abgaben aller
# Studierenden. Bewusst getrennt vom Pflege-Passwort. Ist der Code leer, kann
# sich niemand als Lehrende:r anlegen.
TEACHER_CODE=

# ---------------------------------------------------------------------------
# Datenbank (SQLite, Default private/data/biomech.sqlite)
# ---------------------------------------------------------------------------
BIOMECH_DB=
